---
import PageLayout from '@/layouts/Base.astro'

const meta = {
  description: "I'm a starter theme for Astro.build",
  title: 'About',
}
---

<PageLayout meta={meta}>
  <div class="space-y-6">
    <h1 class="title">Contact me:</h1>
    <p>I can be found and connected from the following locations below:</p>

    <p>
      Email at:
      <span id="email" class="text-blue-600 underline">sumitkanpur2005@gmail.com</span>
      <button
        onclick="copyEmail()"
        class="ml-2 px-2 py-1 bg-gray-200 rounded hover:bg-gray-300 text-sm"
      >
        Copy
      </button>
    </p>

    <div
      id="toast"
      class="hidden fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded shadow-lg transition-opacity duration-300"
    >
      Email copied to clipboard ✅
    </div>

    <ul>
      <li>
        Twitter:
        <a class="inline-block sm:text-link" href="https://twitter.com/SumitK371">SumitK371</a>
      </li>
      <li>
        Github:
        <a class="inline-block sm:text-link" href="https://github.com/SumitKumar-17">
          SumitKumar-17
        </a>
      </li>
      <li>
        Linkedin:
        <a class="inline-block sm:text-link" href="https://www.linkedin.com/in/sumitkumar371">
          sumitkumar371
        </a>
      </li>
    </ul>
  </div>

  <script is:inline>
    function copyEmail() {
      const email = 'sumitkanpur2005@gmail.com';
      navigator.clipboard.writeText(email).then(() => {
        const toast = document.getElementById('toast');
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2000);
      });
    }
  </script>
</PageLayout>
